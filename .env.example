# Public SPA origin for absolute client URLs (no trailing slash)
VITE_APP_ORIGIN=http://localhost:5173

# Backend API origin (no trailing slash). Leave empty in dev to use Vite /api proxy.
VITE_API_BASE_URL=

# Dev-only: Vite proxy target when VITE_API_BASE_URL is empty
VITE_API_PROXY_TARGET=http://localhost:3000

# Set to true when the API uses HttpOnly cookies / credentialed cross-origin requests
VITE_API_WITH_CREDENTIALS=false

# OAuth (optional — used by src/const.ts)
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# Google Maps proxy (optional — used by src/components/Map.tsx)
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# Analytics (optional — injected into index.html at build time)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
